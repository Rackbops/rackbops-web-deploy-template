#!/usr/bin/env bash
# <app> auto-deploy -- pull the latest site from GitHub onto the box (pull model).
#
# Copy to `deploy/deploy-pull.sh` in your app repo and set REPO_DIR below. This is the PULL
# publish model: the box holds a clone of the repo AS its Dockge stack (the repo root IS the stack
# dir), and a systemd system timer (see the paired .service/.timer) runs this on a poll. Use it
# when the repo can live on the box directly (a private repo is fine with a read-only deploy key);
# use the scp push model (publish-scp.ps1) instead when it can't.
#
# Template, incl. the "Push or pull?" section behind that choice -- relative paths won't resolve
# from your repo:
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#push-or-pull
# What each kind of change needs on the box:
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#updating
#
# The clone IS the stack dir in this model, so a pull ships whatever you commit -- site content,
# but also compose.yaml, nginx.conf and the deploy/ units, which each need a DIFFERENT action on
# the box. This script diffs the pull and logs the action needed as a reminder rather than doing
# it unattended, which keeps the timer privilege-light (no docker, no sudo). Which change needs
# what, and why, lives in the "Updating" section linked above -- not restated here.
#
# The whole body is wrapped in main() so bash parses it before running: a pull that updates this
# very file mid-run can't trip over a half-read script.
set -euo pipefail

REPO_DIR="/opt/stacks/<app>"   # the clone-as-stack dir on the box

main() {
  cd "$REPO_DIR" || exit 1

  local before after
  before="$(git rev-parse HEAD)"
  git pull --ff-only --quiet
  after="$(git rev-parse HEAD)"

  if [[ "$before" == "$after" ]]; then
    echo "<app>: up to date at ${after:0:7}, nothing to do."
    return 0
  fi

  echo "<app>: updated ${before:0:7} -> ${after:0:7}."

  # === POST-ARRIVAL (per-server) ================================================================
  # The logic above is transport: fetch, compare, decide whether anything moved -- server-agnostic.
  # The path-to-action map below is not: it knows what an nginx-static stack is made of, and is the
  # block a second base server would swap. (The exit-status note at the very bottom is generic
  # again, and the file header names these paths too.)
  #
  # Path-to-action map, not a single compose.yaml special case: each of these needs a DIFFERENT
  # action on the box, and more than one can be true in the same pull. `git diff --name-only`
  # returns paths relative to the repo root, matching these patterns as-is since we already `cd`'d
  # into $REPO_DIR above.
  local changed_files needs_up=0 needs_restart=0 needs_reload_units=0 content_only=1
  # --no-renames: git's default rename detection would otherwise collapse a renamed
  # compose.yaml/nginx.conf/unit file down to just its NEW path in --name-only output, so the old
  # name never appears here and the change silently falls through as content-only.
  changed_files="$(git diff --no-renames --name-only "$before" "$after")"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    case "$f" in
      compose.yaml)
        needs_up=1
        content_only=0
        ;;
      nginx.conf)
        needs_restart=1
        content_only=0
        ;;
      # Note: the * here also matches a nested path like deploy/sub/app.service, not just a flat
      # deploy/<name>.service -- accepted over-match (still correctly flags a systemd-unit-shaped
      # file as needing a re-copy + daemon-reload, just occasionally for a file that isn't actually
      # an installed unit) rather than a fragile extglob to anchor it to one path segment.
      deploy/*.service|deploy/*.timer)
        needs_reload_units=1
        content_only=0
        ;;
    esac
  done <<< "$changed_files"

  (( needs_up )) && echo "<app>: compose.yaml changed -- run 'docker compose up -d' in $REPO_DIR to apply it."
  # NOT `nginx -s reload`: a pull's `git checkout` replaces nginx.conf via a new inode (unlink +
  # create), and Docker's single-file bind mount keeps watching the OLD inode -- a reload after a
  # pull silently keeps serving the stale config. Only a restart re-resolves the host path.
  (( needs_restart )) && echo "<app>: nginx.conf changed -- run 'docker compose restart <app>' in $REPO_DIR to apply it (a reload will NOT pick this up after a pull -- see https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#updating)."
  (( needs_reload_units )) && echo "<app>: a deploy/*.service or *.timer unit changed -- re-copy it to /etc/systemd/system/ and run 'sudo systemctl daemon-reload' to apply it."
  (( content_only )) && echo "<app>: site content updated; no restart needed (nginx serves the mounted files)."
  # To apply compose.yaml changes automatically too, uncomment the next line
  # (requires the timer's user to be in the 'docker' group):
  # (( needs_up )) && docker compose up -d

  # Explicit success exit: the four `(( flag )) && echo` checks above each have their OWN exit
  # status of 1 when that flag is false (the echo never runs to overwrite it), so without this the
  # script's exit code would depend on which flag happened to be checked last -- reporting failure
  # to systemd (and every deploy log) on a run that actually succeeded.
  return 0
}

main
