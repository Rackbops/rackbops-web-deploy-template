#!/usr/bin/env bash
# <app> auto-deploy -- pull the latest site from GitHub onto the box (pull model).
#
# Copy to `deploy/deploy-pull.sh` in your app repo and set REPO_DIR below. This is the PULL
# publish model: the box holds a clone of the repo AS its Dockge stack (the repo root IS the stack
# dir), and a systemd system timer (see the paired .service/.timer) runs this on a poll. Use it
# when the repo can live on the box directly (a private repo is fine with a read-only deploy key);
# use the scp push model (publish-scp.ps1) instead when it can't.
#
# Template, incl. the "Push or pull?" section behind that choice -- relative paths won't resolve
# from your repo:
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#push-or-pull
# What each kind of change needs on the box:
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#updating
#
# The clone IS the stack dir in this model, so a pull ships whatever you commit -- site content,
# but also compose.yaml, nginx.conf and the deploy/ units, which each need a DIFFERENT action on
# the box. This script diffs the pull and logs the action needed as a reminder rather than doing
# it unattended, which keeps the timer privilege-light (no docker, no sudo). Which change needs
# what, and why, lives in the "Updating" section linked above -- not restated here.
#
# The whole body is wrapped in main() so bash parses it before running: a pull that updates this
# very file mid-run can't trip over a half-read script.
set -euo pipefail

REPO_DIR="/opt/stacks/<app>"   # the clone-as-stack dir on the box

# First 10 lines of $1, each prefixed, then a "... and N more" tally. `sed -n`, NOT `| head`: head
# closes the pipe after 10 lines and the writer then dies of SIGPIPE, which pipefail+set -e turn
# into an abort in the CALLER -- silently swallowing everything below, in exactly the large-list
# case this exists for. The trailing `if` (not `(( n > 0 )) && echo`) keeps this function's exit
# status 0 when it is the last thing a caller runs under set -e.
print_head10() {
  sed -n "1,10{s|^|<app>:       |;p;}" <<< "$1"
  local n_more=$(( $(wc -l <<< "$1") - 10 ))
  if (( n_more > 0 )); then echo "<app>:       ... and $n_more more"; fi
}

main() {
  cd "$REPO_DIR" || exit 1

  local before after
  before="$(git rev-parse HEAD)"

  # If the pull fails, git has already said what it refused to do -- add only the box-specific
  # facts it can't know, and never guess at a cause: a failure here is just as likely to be the
  # network, DNS, or credentials as anything about this clone, and in those cases git's message
  # above IS the whole answer. So the block below adds nothing unless this clone's own state is
  # part of the story.
  if ! git pull --ff-only --quiet; then
    local lock status_out ahead
    lock="$(git rev-parse --absolute-git-dir)/index.lock"
    # Plain --porcelain, NOT -uno: an UNTRACKED file at a path the incoming commit also wants to
    # create blocks --ff-only too ("untracked working tree files would be overwritten by merge"),
    # the same as a killed checkout leaving a tracked file behind. Listing an untracked entry
    # isn't blaming it as the cause -- the line below says so.
    status_out="$(git status --porcelain 2>/dev/null || true)"
    ahead="$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
    if [[ -e "$lock" || -n "$status_out" || "$ahead" != 0 ]]; then
      echo "<app>: pull failed. Git's reason is above; this clone's own local state, which may or"
      echo "<app>:   may not be why -- an unrelated leftover file can coincide with a real network"
      echo "<app>:   or auth failure:"
      if [[ -e "$lock" ]]; then
        echo "<app>:   * stale lock from a killed run. If no git is running here:  rm $lock"
      fi
      if [[ -n "$status_out" ]]; then
        echo "<app>:   * local changes (M/D = tracked, ?? = untracked -- either can block a pull):"
        print_head10 "$status_out"
      fi
      if (( ahead > 0 )); then
        echo "<app>:   * $ahead commit(s) here not on upstream: a box-side commit (never commit on"
        echo "<app>:     the box), OR upstream history was rewritten -- e.g. a force-push to purge a"
        echo "<app>:     leaked value. The reset below is the fix either way."
      fi
      echo "<app>:   To force this clone to exactly match upstream:"
      echo "<app>:     git -C $REPO_DIR reset --hard @{u}"
      echo "<app>:   DESTROYS tracked edits and box-side commits, and overwrites an untracked file"
      echo "<app>:   sitting at a path upstream wants to create -- it does NOT touch any OTHER"
      echo "<app>:   untracked file. @{u} matters: reset --hard with no ref targets current HEAD,"
      echo "<app>:   which is a no-op here. (If the branch has no upstream configured, @{u} won't"
      echo "<app>:   resolve -- fix the tracking first.)"
    fi
    return 1
  fi

  after="$(git rev-parse HEAD)"

  # A successful pull is NOT proof the served content is right. The web root IS this worktree, so
  # tracked files that don't match HEAD are being served in that state. A killed checkout is NOT how
  # that happens silently, though: an interrupted `git checkout` leaves HEAD at the OLD commit, so
  # the next `git pull --ff-only` recomputes the same old->new diff -- which still lists every path
  # the killed run touched -- and refuses LOUDLY ("Your local changes ... would be overwritten"),
  # i.e. the pull above already failed and this block never runs. This NOTE is for the states a clean
  # pull genuinely does NOT catch: an edit made on the box, a filemode (chmod) change, or a submodule
  # pointer that moved while its worktree did not.
  #
  # WARNS, does not fail. Those states are frequently healthy and permanent, so failing the unit on
  # them would convert a working deployment into one that fails every tick -- worse than what this
  # surfaces. It also must not `return` here: the post-arrival reminders below still need to run,
  # since the pull DID land and compose.yaml/nginx.conf may have changed.
  local worktree_drift
  worktree_drift="$(git status --porcelain -uno || true)"
  if [[ -n "$worktree_drift" ]]; then
    echo "<app>: NOTE -- these tracked files do not match HEAD, so the web root is serving them"
    echo "<app>:   in that state. Cause is an edit made on the box, a submodule pointer, or a"
    echo "<app>:   filemode change -- check before assuming (a killed run fails the pull, above):"
    print_head10 "$worktree_drift"
    echo "<app>:   To make the tree match upstream exactly (DESTROYS local edits; needs @{u} to"
    echo "<app>:   resolve, so fix the branch's tracking first if it has none):"
    echo "<app>:     git -C $REPO_DIR reset --hard @{u}"
    echo "<app>:   A submodule bump needs \`git submodule update --init --recursive\` instead."
  fi

  if [[ "$before" == "$after" ]]; then
    echo "<app>: up to date at ${after:0:7}, nothing to do."
    return 0
  fi

  echo "<app>: updated ${before:0:7} -> ${after:0:7}."

  # === POST-ARRIVAL (per-server) ================================================================
  # The logic above is transport: fetch, compare, decide whether anything moved -- server-agnostic.
  # The path-to-action map below is not: it knows what an nginx-static stack is made of, and is the
  # block a second base server would swap. (The exit-status note at the very bottom is generic
  # again, and the file header names these paths too.)
  #
  # Path-to-action map, not a single compose.yaml special case: each of these needs a DIFFERENT
  # action on the box, and more than one can be true in the same pull. `git diff --name-only`
  # returns paths relative to the repo root, matching these patterns as-is since we already `cd`'d
  # into $REPO_DIR above.
  local changed_files needs_up=0 needs_restart=0 needs_reload_units=0
  # --no-renames: git's default rename detection would otherwise collapse a renamed
  # compose.yaml/nginx.conf/unit file down to just its NEW path in --name-only output, so the old
  # name never appears here and the change silently falls through as content-only.
  changed_files="$(git diff --no-renames --name-only "$before" "$after")"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    case "$f" in
      compose.yaml|compose.yml|docker-compose.yaml|docker-compose.yml)
        needs_up=1
        ;;
      nginx.conf)
        needs_restart=1
        ;;
      # Note: the * here also matches a nested path like deploy/sub/app.service, not just a flat
      # deploy/<name>.service -- accepted over-match (still correctly flags a systemd-unit-shaped
      # file as needing a re-copy + daemon-reload, just occasionally for a file that isn't actually
      # an installed unit) rather than a fragile extglob to anchor it to one path segment.
      deploy/*.service|deploy/*.timer)
        needs_reload_units=1
        ;;
    esac
  done <<< "$changed_files"

  # content_only is just "none of the above fired", derived once here instead of a fourth flag each
  # arm must remember to clear. (A new arm must still add its flag to the || below, or it prints its
  # reminder AND "site content updated" together -- the trap is relocated to this one line, not gone.)
  local content_only=$(( !(needs_up || needs_restart || needs_reload_units) ))

  if (( needs_up )); then echo "<app>: a compose file changed -- run 'docker compose up -d' in $REPO_DIR to apply it."; fi
  # NOT `nginx -s reload` after a pull -- why is in the README's "#updating" (the echo below links it).
  if (( needs_restart )); then echo "<app>: nginx.conf changed -- run 'docker compose restart <app>' in $REPO_DIR to apply it (a reload will NOT pick this up after a pull -- see https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#updating)."; fi
  if (( needs_reload_units )); then echo "<app>: a deploy/*.service or *.timer unit changed -- re-copy it to /etc/systemd/system/ and run 'sudo systemctl daemon-reload' to apply it."; fi
  if (( content_only )); then echo "<app>: site content updated; no restart needed (nginx serves the mounted files)."; fi
  # To apply compose changes automatically too, uncomment the next line -- BUT it requires the
  # timer's user to be in the 'docker' group, which is root-equivalent, so it makes anyone who can
  # push to the tracked branch root on the box (see the README's pull-model trust note):
  # if (( needs_up )); then docker compose up -d; fi
  # An `if` is the last command above, so main() exits 0 on a healthy run with no explicit `return`
  # -- unlike `(( flag )) && echo`, whose exit status is 1 whenever the flag is false.
}

main
