# <app> auto-deploy -- polls GitHub for site updates by firing the paired .service on a schedule.
#
# Copy to `deploy/<app>-deploy.timer` in your app repo, adapt <app>, and install on the box as a
# SYSTEM unit under /etc/systemd/system/ (paired with the .service). Install steps are under
# "Installing the pull timer" in the template README -- relative paths won't resolve from your repo:
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md
#
# `OnBootSec=` is what runs it after the box comes back up. Tune OnUnitActiveSec to how quickly you
# want a push to go live (5 min is the reference default; shorter polls GitHub more often).

[Unit]
Description=<app> -- poll GitHub for site updates

[Timer]
# Explicit, not relying on the default same-stem pairing (foo.timer -> foo.service), so the file
# says which service it fires and the two halves need not share a stem. This does NOT make a
# mis-pairing quieter: if the named service isn't installed, starting the timer fails its job
# outright, logging "Refusing to start, unit <x>.service to trigger not loaded" to the journal --
# same as the implicit pairing would. Keep this in sync with whatever you name the .service file.
Unit=<app>-deploy.service
# Runs 2 min after boot, then every 5 min after each run. Keep BOTH: OnUnitActiveSec= alone is
# measured from the last activation, so after a reboot it would never fire until something started
# the service by hand -- the box would silently stop auto-deploying. OnBootSec= is what restarts
# the cycle.
OnBootSec=2min
OnUnitActiveSec=5min
# Kept only as forward cover for a consumer who switches to OnCalendar=, NOT because it does
# anything for the schedule above: systemd.timer(5) says Persistent= "only has an effect on timers
# configured with OnCalendar=", and this timer is monotonic. It does still write a stamp file on
# every trigger, but only the calendar path reads that back -- so it is NOT what catches the box up
# after downtime here (OnBootSec= above is). Delete the line if you'd rather carry nothing unused.
Persistent=true

[Install]
WantedBy=timers.target
