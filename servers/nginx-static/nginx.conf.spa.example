# <app> -- served by nginx:alpine. SPA / client-side-routed build (React + Vite, etc.).
#
# Copy THIS file to `nginx.conf` in your app repo if unknown paths should fall back to
# index.html so a client router can take over. If your site is hand-authored HTML with no
# client router, copy `nginx.conf.static.example` instead -- it 404s unknown paths honestly.
# Take exactly one; the choice is the act of copying, so there is nothing to uncomment.
#
# Template (relative paths won't resolve from your repo):
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md
# What needs a restart, and how a change reaches the box:
#   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md#updating
#
# Mounted at /etc/nginx/conf.d/default.conf -- despite the name you may give it, this is a
# `server {}` FRAGMENT, not a full nginx.conf: the base image's real nginx.conf already supplies
# http{}/events{} and includes conf.d/*.conf. Content-free by design.
#
# A change to THIS file needs `docker compose restart <app>` -- it is the one change that does,
# unlike site content. How the change reaches the box, why `nginx -s reload` is not a substitute
# after a git pull, and what the other stack files need are all in ONE place: the "Updating"
# section linked above. Don't restate them here; a caveat added there should not have to be
# found in six other files.
server {
    # === SHARED with nginx.conf.static.example, down to the `location /` block. Fix a bug in
    # === one of these files and fix it in the other; the two are meant to differ ONLY in how
    # === an unknown path is answered.

    # Match compose.yaml's CONTAINER_PORT. 80 is the stock default (keep it unless you have a
    # reason not to); if you set a custom port here it must equal the right-hand side of the
    # "127.0.0.1:<HOST_PORT>:<CONTAINER_PORT>" publish.
    listen 80;

    root  /usr/share/nginx/html;
    index index.html;

    # Liveness probe -- exact match, so it never falls through to the `location /` below. Optional but
    # cheap; a co-located uptime monitor or a deploy healthcheck can hit it. (tools-site has this;
    # rackbops does not -- keep it or delete it.)
    location = /healthz {
        return 200;
    }

    # Deny dotfiles/dirs (.git, .env, ...) except /.well-known/ (ACME challenges etc.) -- matters
    # most for the repo-root web-root mount (the "#web-root-knob" section of the template README
    # linked at the top of this file), where .git/ would otherwise be directly readable; harmless
    # elsewhere since these paths won't exist under a ./dist or ./site mount. `return 404` (not
    # `deny all`) is what actually applies here -- it fires in nginx's rewrite phase, before the
    # access-phase `deny` would even run.
    location ~ /\.(?!well-known/) {
        return 404;
    }
    # Same reasoning, for the repo-root-level stack files a repo-root mount would also expose.
    # Exact/prefix match, not directory-wide like the dotfile rule above -- a same-named file
    # elsewhere in the tree (e.g. a docs copy at /some/nginx.conf) is a different, ordinary file
    # and is untouched by these.
    location = /compose.yaml { return 404; }
    location = /nginx.conf   { return 404; }
    location ^~ /deploy/     { return 404; }

    # === END SHARED. Below is what makes this the SPA variant. ===

    # Every unknown path falls back to index.html so the client router can take over -- which
    # means this server answers 200 for paths that do not exist. That is correct for an app and
    # wrong for a content site: use nginx.conf.static.example there.
    # NOTE: with a repo-root web root and NO root index.html, this fallback loops until nginx
    # aborts the request with a 500 -- see the README's "#web-root-knob" section.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
