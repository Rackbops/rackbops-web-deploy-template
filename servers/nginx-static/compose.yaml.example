# <app> -- static site served by a stock nginx:alpine container, bound to loopback only.
#
# Copy to `compose.yaml` in your app repo and fill in the <PLACEHOLDERS>. Managed as a Dockge
# stack at /opt/stacks/<app>/ on the box. There is NO custom image to build -- nginx:alpine is
# used unmodified; the site is just files mounted read-only into its web root.
#
# Template (the runbooks this was copied from -- relative paths won't resolve from your repo):
#   server: https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md
#   gate:   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/gate/README.md
#
# The 127.0.0.1 bind is the security floor: nginx is reachable only over loopback, and the
# Cloudflare Tunnel + Access gate sit in front of it (the gate runbook above). If this ever binds
# 0.0.0.0 the site is exposed on the LAN with no auth -- don't.

services:
  <app>:
    image: nginx:alpine
    container_name: <app>
    restart: unless-stopped
    ports:
      # "<HOST_PORT>:<CONTAINER_PORT>" -- both are yours to choose and they need NOT match.
      #   * HOST_PORT: any free loopback port on the box (check `ss -ltnp` first). Must match the
      #     tunnel ingress rule -- the two are set independently and nothing checks they agree.
      #     A mismatch gives an authenticated visitor a 502 (cloudflared can't reach the origin)
      #     while nginx is healthy on loopback. Note the gate's own closed-door check can't catch
      #     it: an UNauthenticated probe gets its 302 to the login page without ever reaching the
      #     origin, so test this one after logging in. Ingress rule:
      #     https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/gate/README.md
      #   * CONTAINER_PORT: whatever nginx.conf's `listen` says. Keep it 80 (the stock default)
      #     and there's nothing to change in nginx.conf; use a custom port only if you have a
      #     reason to. (Of the two reference consumers, one keeps 80 and one uses a custom port --
      #     both are fine.)
      - "127.0.0.1:<HOST_PORT>:<CONTAINER_PORT>"
    volumes:
      # BOTH sources below must exist on the box BEFORE the first `up` -- except with the
      # repo-root web-root knob, where the web root IS the stack dir and only nginx.conf applies.
      # Docker's short mount syntax silently creates a missing source as a ROOT-OWNED DIRECTORY,
      # and neither failure announces itself as one:
      #   * web root missing -> the container starts and runs normally, serving an empty
      #     root-owned dir (a bare `/` then 403s). The first publish-scp.ps1 run dies in the swap
      #     with `Permission denied` -- it runs as <user>, the dir is root:root 755. Re-running
      #     never fixes it: remove or chown that dir first, then publish again.
      #   * nginx.conf missing -> a DIRECTORY of that name, and the container fails to START:
      #     "not a directory: Are you trying to mount a directory onto a file (or vice-versa)?"
      #     -- nginx never runs, so there is no nginx error to read.
      # Both dirs are created even when the start fails, so delete them before retrying.
      # The server README's order avoids all of this. Dockge does not: its editor writes only
      # compose.yaml and .env, and Deploy runs `docker compose up -d` straight away -- so put
      # nginx.conf and your content on the box by other means BEFORE you deploy the stack.
      #
      # WEB-ROOT KNOB -- the left side is which local directory becomes nginx's web root. It is
      # NOT always a subdir called `dist`/`site`:
      #   * a build artifact:      ./dist:/usr/share/nginx/html:ro   (e.g. a Vite/React build)
      #   * a hand-authored dir:   ./site:/usr/share/nginx/html:ro   (e.g. rackbops' one-pager)
      #   * the REPO ROOT itself:  .:/usr/share/nginx/html:ro        (pull model only -- read the
      #                            server README's "#web-root-knob" section first, linked above)
      - <WEB_ROOT_DIR>:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro   # scp push never re-ships this; git-pull ships whatever you commit (see nginx.conf.example)
