# <app> -- static site served by a stock nginx:alpine container, bound to loopback only.
#
# Copy to `compose.yaml` in your app repo and fill in the <PLACEHOLDERS>. Managed as a Dockge
# stack at /opt/stacks/<app>/ on the box. There is NO custom image to build -- nginx:alpine is
# used unmodified; the site is just files mounted read-only into its web root.
#
# Template (the runbooks this was copied from -- relative paths won't resolve from your repo):
#   server: https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/nginx-static/README.md
#   gate:   https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/gate/README.md
#
# The 127.0.0.1 bind is the security floor: nginx is reachable only over loopback, and the
# Cloudflare Tunnel + Access gate sit in front of it (the gate runbook above). If this ever binds
# 0.0.0.0 the site is exposed on the LAN with no auth -- don't.
#   CAVEAT: "reachable only over loopback" holds on Docker Engine >= 28.0.0. On older engines a host
#   on the same L2 segment (same switch) can reach a 127.0.0.1-published port even though `ss` shows
#   127.0.0.1 -- Docker fixed this in 28.0.0 (moby/moby#49325). Check `docker version` (Server); many
#   distro-packaged engines still lag. See the gate runbook's step 0 for the full note.

services:
  <app>:
    image: nginx:alpine
    container_name: <app>
    restart: unless-stopped
    ports:
      # "<HOST_PORT>:<CONTAINER_PORT>" -- both are yours to choose and they need NOT match.
      #   * HOST_PORT: any free loopback port on the box (check `ss -ltnp` first). Must match the
      #     tunnel ingress rule -- the two are set independently and nothing checks they agree.
      #     A mismatch gives an authenticated visitor a 502 (cloudflared can't reach the origin)
      #     while nginx is healthy on loopback. Note the gate's own closed-door check can't catch
      #     it: an UNauthenticated probe gets its 302 to the login page without ever reaching the
      #     origin, so test this one after logging in. Ingress rule:
      #     https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/gate/README.md
      #   * CONTAINER_PORT: whatever nginx.conf's `listen` says. Keep it 80 (the stock default)
      #     and there's nothing to change in nginx.conf; use a custom port only if you have a
      #     reason to. (Of the two reference consumers, one keeps 80 and one uses a custom port --
      #     both are fine.)
      - "127.0.0.1:<HOST_PORT>:<CONTAINER_PORT>"
    volumes:
      # BOTH sources below must exist on the box BEFORE the first `up` (except with the repo-root
      # web-root knob, where the web root IS the stack dir, so only nginx.conf applies). The long
      # mount syntax with `create_host_path: false` makes Docker REFUSE at container-create, naming
      # the missing path ("bind source path does not exist: .../nginx.conf"), instead of the SHORT
      # `src:dst:ro` syntax's default of silently creating it as a ROOT-OWNED dir -- which serves an
      # empty web root that 403s, or leaves a directory where nginx.conf should be a file, both
      # needing manual cleanup. So a Dockge Deploy (it runs `docker compose up -d` straight from its
      # editor, which writes only compose.yaml/.env) fails loudly until nginx.conf and your content
      # are on the box, rather than serving an empty root-owned dir. Long syntax is inferred --
      # neither reference consumer carries it yet; on a correctly-populated box the behaviour is
      # identical to the short form. The guard itself needs a compose that recognises
      # `create_host_path` (compose v2.20+, i.e. any modern Docker); an older compose silently
      # ignores the key and reverts to auto-create -- another reason to stay on a current engine.
      #
      # WEB-ROOT KNOB -- `source:` is which local directory becomes nginx's web root. It is NOT
      # always a subdir called `dist`/`site`:
      #   * a build artifact:      ./dist   (e.g. a Vite/React build)
      #   * a hand-authored dir:   ./site   (e.g. rackbops' one-pager)
      #   * the REPO ROOT itself:  .        (pull model only -- read the server README's
      #                            "#web-root-knob" section first, linked above)
      - type: bind
        source: <WEB_ROOT_DIR>
        target: /usr/share/nginx/html
        read_only: true
        bind:
          create_host_path: false
      # Copy ONE of nginx.conf.spa.example / nginx.conf.static.example to nginx.conf -- see the
      # server README's "SPA vs. plain static". The scp push never re-ships this file; the
      # git-pull model ships whatever you commit.
      - type: bind
        source: ./nginx.conf
        target: /etc/nginx/conf.d/default.conf
        read_only: true
        bind:
          create_host_path: false
