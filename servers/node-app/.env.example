# <app> node-app deploy -- copy to `.env` (next to compose.yaml in the stack dir) and fill the
# <PLACEHOLDERS>. Compose reads it for ${...} substitution; publish/deploy-pull.sh reads REGISTRY_*
# to log in before pulling. RUNTIME SECRETS ONLY -- never committed, never an image layer.
#
# This is a PUBLIC template: every operator SECRET below is a <PLACEHOLDER>, never a real token (the
# concrete defaults like ghcr.io / latest / 0.0.0.0 are non-secret). NEVER commit a filled-in .env --
# gitignore it in your app repo.

# --- The image to run (deploy-pull.sh resolves the same ref via `docker compose config --images`) ---
# Reference consumer: IMAGE=ghcr.io/rackbops/artifact-console
IMAGE=<REGISTRY_IMAGE>
# A moving tag (latest) auto-swaps on each new digest; a pinned vX.Y.Z is reproducible, manual-bump.
IMAGE_TAG=latest

# --- Private-registry pull auth (deploy-pull.sh: `docker login $REGISTRY -u $REGISTRY_USER`) ---
# For a PRIVATE ghcr package the box needs a read:packages credential. Defaults suit ghcr.io.
REGISTRY=ghcr.io
REGISTRY_USER=<REGISTRY_USERNAME>
REGISTRY_TOKEN=<REGISTRY_READ_PACKAGES_TOKEN>

# --- The per-app Cloudflare token tunnel (the cloudflared sidecar reads this) ---
# From the Access-app + tunnel setup in the gate runbook (Cloudflare API), for THIS app's own tunnel.
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>

# --- The app's own config (optional; the image ships sane defaults) ---
# artifact-console binds all interfaces so the sidecar can reach it in-network:
AC_HOST=0.0.0.0
