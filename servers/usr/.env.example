# usr deploy -- copy to `.env` (next to compose.yaml in the stack dir, /opt/stacks/usr/) and fill the
# <PLACEHOLDERS>, then `chmod 600 .env`. Compose reads it for ${...} substitution; publish/deploy-pull.sh
# (node-app's) reads REGISTRY_* from it to log in before pulling. RUNTIME SECRETS ONLY -- never committed,
# never an image layer.
#
# This is a PUBLIC template: every SECRET and every site-specific value below is a <PLACEHOLDER>, never
# a real one (the concrete defaults like ghcr.io / latest / 30m / /opt/usr/postgres are neither secret
# nor site-specific). NEVER commit a filled-in .env.
#
# The variable NAMES for the image, the registry login and the tunnel token are node-app's own
# (servers/node-app/.env.example), on purpose: node-app's deploy-pull.sh and set-tunnel-token.sh read
# exactly these names and are used here unchanged.

# --- The image to run (deploy-pull.sh resolves the same ref via `docker compose config --images usr`) ---
IMAGE=<REGISTRY_IMAGE>
# A moving tag (latest) auto-swaps on each new digest usr's CI publishes; a pinned vX.Y.Z is manual-bump.
IMAGE_TAG=latest

# --- Private-registry pull auth (deploy-pull.sh: `docker login $REGISTRY -u $REGISTRY_USER`) ---
# usr's image is a PRIVATE ghcr package, so the box needs a read:packages credential. Defaults suit ghcr.io.
REGISTRY=ghcr.io
REGISTRY_USER=<REGISTRY_USERNAME>
REGISTRY_TOKEN=<REGISTRY_READ_PACKAGES_TOKEN>

# --- The per-app Cloudflare token tunnel (the cloudflared sidecar reads this) ---
# Write it with node-app's publish/set-tunnel-token.sh.example, not by hand (README step 3).
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>

# --- Postgres (usr's own database, in this same stack) ---
# Generate once: `openssl rand -hex 24`. Hex only: it is spliced into a postgres:// URL unescaped.
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
# Host directory the database lives in (the mount is its /var/lib/postgresql). Create it before step 4.
USR_PG_DATA_DIR=/opt/usr/postgres

# --- usr itself ---
# The parent domain the `nz_id` SSO cookie is scoped to: every app under it receives the cookie, so
# this must be a parent of usr's own hostname AND of every app that should sign in through usr.
USR_SSO_COOKIE_DOMAIN=<COOKIE_DOMAIN>
# Lifetime of the identity token inside that cookie (usr's own default is 30m).
USR_SSO_TOKEN_TTL=30m
# usr's public origin (the hostname the Access app and the tunnel ingress serve it on).
USR_PUBLIC_URL=https://<USR_HOSTNAME>
