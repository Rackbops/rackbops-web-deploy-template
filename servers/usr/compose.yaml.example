# usr -- centralized users + app-scoped roles + cross-app SSO (a Hono API + React SPA over its own
# Postgres), run as a `servers/node-app`-shaped project: a built image, a per-app cloudflared token-tunnel
# sidecar, NO host port. Managed as a Dockge stack at /opt/stacks/usr/.
#
# Copy to `compose.yaml`, copy `.env.example` to `.env` next to it and fill the <PLACEHOLDERS>.
# Runbooks (relative paths won't resolve from your repo):
#   this project: https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/usr/README.md
#   node-app:     https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/servers/node-app/README.md
#   gate:         https://github.com/Rackbops/rackbops-web-deploy-template/blob/main/gate/README.md
#
# Like node-app, nothing here publishes a host port: usr is reachable ONLY in-network, by the
# cloudflared sidecar (service name `usr`, container port 8432), and Postgres only by usr. Cloudflare
# Access is the only door. (usr's OWN docker-compose.yml publishes 127.0.0.1:8432 and 127.0.0.1:5434 for
# local dev -- that is deliberately not carried over.) The tunnel's ingress points at `http://usr:8432`.
#
# What differs from node-app/compose.yaml.example: a second service (Postgres), because usr cannot run
# without one; its data lives in a host directory, not a named volume (see `postgres` below); and the
# app container's config is usr's own environment, not artifact-console's.

services:
  usr:
    # The published image of usr (a PRIVATE ghcr package -- publish/deploy-pull.sh logs in with the
    # REGISTRY_* credential from .env before pulling). A MOVING tag (`latest`) is what usr's own CI
    # publishes on every push to main, so the deploy timer swaps the container on each new digest; pin
    # `vX.Y.Z` instead for a manual-bump deploy. Set both parts in .env (IMAGE, IMAGE_TAG).
    image: ${IMAGE}:${IMAGE_TAG:-latest}
    container_name: usr
    restart: unless-stopped
    # Explicit vars, NOT `env_file: [.env]`: this container has no need to see CLOUDFLARE_TUNNEL_TOKEN or
    # REGISTRY_TOKEN. The image's own defaults cover PORT (8432); migrations run at boot, before it listens.
    environment:
      # usr's default is postgres://usr:usr@postgres:5432/usr; the password is set here instead. The URL
      # is not escaped for you: use a password of hex digits (`openssl rand -hex 24`), nothing that
      # needs percent-encoding.
      - DATABASE_URL=postgres://usr:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@postgres:5432/usr
      # Cross-app SSO is OFF unless this is set (an empty value is off). It is the parent domain the
      # `nz_id` identity cookie is scoped to, so every app under it receives the cookie.
      - USR_SSO_COOKIE_DOMAIN=${USR_SSO_COOKIE_DOMAIN:?set USR_SSO_COOKIE_DOMAIN in .env}
      - USR_SSO_TOKEN_TTL=${USR_SSO_TOKEN_TTL:-30m}
      # The public origin for the registration links a Discord bot hands out when it reaches usr
      # internally (default: the request's own origin). Set it so those links carry the public hostname.
      - USR_PUBLIC_URL=${USR_PUBLIC_URL:?set USR_PUBLIC_URL in .env}
    depends_on:
      postgres:
        condition: service_healthy
    # The image ships no HEALTHCHECK. `GET /api/health` answers {"ok":true} without authentication.
    # `node` is already in the image, so no curl/wget is assumed; the long start_period covers the
    # migrations that run at boot.
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:8432/api/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # NO `ports:` -- reachable only in-network via the cloudflared sidecar below.

  postgres:
    image: postgres:18
    container_name: usr-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER=usr
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      - POSTGRES_DB=usr
      # NOTE: the password only takes effect when the data directory is first initialised. Changing it in
      # .env later does NOT change the database's -- see the README's "Changing the Postgres password".
    volumes:
      # A host directory, not a named volume, so the data sits at a path you choose and can back up
      # (README step 5). postgres:18+ keeps data in a version-specific subdirectory, so the mount is the
      # PARENT (/var/lib/postgresql), not /var/lib/postgresql/data as on <=16 (usr's own compose does the
      # same). Create the directory first (README step 3).
      - ${USR_PG_DATA_DIR:-/opt/usr/postgres}:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U usr -d usr"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # NO `ports:` -- unlike usr's own compose, Postgres is not published on the host at all.

  cloudflared:
    # Per-app token tunnel (see node-app's README, "The gate"). PIN the tag: the deploy-pull timer only
    # ever pulls and recreates the `usr` service, so an unpinned sidecar would stay on whatever digest was
    # current the day the stack first came up (node-app's README, "Container lockdown").
    image: cloudflare/cloudflared:<CLOUDFLARED_TAG>
    command: tunnel --no-autoupdate run
    environment:
      - TUNNEL_TOKEN=${CLOUDFLARE_TUNNEL_TOKEN}
    restart: unless-stopped
    depends_on:
      # Wait for usr's healthcheck before routing, so the tunnel doesn't briefly 502 at first bring-up.
      usr:
        condition: service_healthy
    profiles:
      - tunnel           # opt-in: `docker compose --profile tunnel up -d` brings up the gate too
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
