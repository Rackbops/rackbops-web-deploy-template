import { describe, expect, it } from "vitest";
import {
  RepoNotAllowedError,
  ValidationError,
  assertRepoAllowed,
  isAllowedEmail,
  parseCsvEnv,
  validateFileIssueRequest,
} from "../src/allowlist";

const TOOLCHAIN_PREFIX = ["<TITLE_PREFIX>"];

const VALID = {
  repo: "<OWNER>/<REPO>",
  title: "<TITLE_PREFIX>upgrade Python on MILE to 3.14",
  body: "Installed: 3.12.10 on MILE\nStandard: minor 3.14",
  labels: ["chore", "priority: low"],
};

describe("validateFileIssueRequest", () => {
  it("accepts a well-formed request", () => {
    expect(validateFileIssueRequest(VALID, TOOLCHAIN_PREFIX)).toEqual(VALID);
  });

  it("accepts a title matching ANY of several allowed prefixes", () => {
    const req = { ...VALID, title: "Kenzen: something" };
    expect(validateFileIssueRequest(req, ["<TITLE_PREFIX>", "Kenzen: "])).toEqual(req);
  });

  it('rejects a title matching none of the allowed prefixes -- mutation guard: remove this check and this test fails', () => {
    expect(() => validateFileIssueRequest({ ...VALID, title: "Please upgrade Python" }, TOOLCHAIN_PREFIX)).toThrow(
      ValidationError,
    );
  });

  // These three use a concrete `Example: ` prefix, not <TITLE_PREFIX>: the mechanism only applies to
  // a prefix that ends in `:`, and your own <TITLE_PREFIX> may not. parseCsvEnv trims
  // `ALLOWED_TITLE_PREFIXES = "Example: "` to `Example:`, so the separating space has to be
  // required again by the validator itself.
  it("enforces a prefix ending in ':' with its separating space, as the var is written -- mutation guard: drop the re-added space and this fails", () => {
    const trimmed = parseCsvEnv("Example: "); // exactly what the Worker hands the validator
    expect(trimmed).toEqual(["Example:"]);
    expect(() => validateFileIssueRequest({ ...VALID, title: "Example:x" }, trimmed)).toThrow(ValidationError);
    expect(() => validateFileIssueRequest({ ...VALID, title: "Example:" }, trimmed)).toThrow(ValidationError);
    expect(validateFileIssueRequest({ ...VALID, title: "Example: x" }, trimmed).title).toBe("Example: x");
  });

  it("names the prefix as enforced, space included, in the rejection", () => {
    expect(() => validateFileIssueRequest({ ...VALID, title: "Example:x" }, ["Example:"])).toThrow(
      '"title" must start with one of: "Example: "',
    );
  });

  it("leaves a prefix that does not end in ':' exactly as configured -- mutation guard: add a space to every prefix", () => {
    const req = { ...VALID, title: "Kenzen-sync2 nightly" };
    expect(validateFileIssueRequest(req, ["Kenzen-sync"])).toEqual(req);
    expect(() => validateFileIssueRequest({ ...VALID, title: "Kenzen-syn" }, ["Kenzen-sync"])).toThrow(ValidationError);
  });

  it("rejects every title when ALLOWED_TITLE_PREFIXES is empty -- fail closed, not open", () => {
    expect(() => validateFileIssueRequest(VALID, [])).toThrow(ValidationError);
  });

  it("rejects a non-string title", () => {
    expect(() => validateFileIssueRequest({ ...VALID, title: 123 }, TOOLCHAIN_PREFIX)).toThrow(ValidationError);
  });

  it("rejects a title over GitHub's own 256-character issue-title limit", () => {
    const tooLong = { ...VALID, title: "<TITLE_PREFIX>" + "x".repeat(300) };
    expect(() => validateFileIssueRequest(tooLong, TOOLCHAIN_PREFIX)).toThrow(ValidationError);
  });

  it('rejects a malformed "repo" (not "owner/name")', () => {
    expect(() => validateFileIssueRequest({ ...VALID, repo: "not-a-repo" }, TOOLCHAIN_PREFIX)).toThrow(
      ValidationError,
    );
    expect(() => validateFileIssueRequest({ ...VALID, repo: 42 }, TOOLCHAIN_PREFIX)).toThrow(ValidationError);
  });

  it("rejects an empty or oversized body", () => {
    expect(() => validateFileIssueRequest({ ...VALID, body: "" }, TOOLCHAIN_PREFIX)).toThrow(ValidationError);
    expect(() => validateFileIssueRequest({ ...VALID, body: "x".repeat(5000) }, TOOLCHAIN_PREFIX)).toThrow(
      ValidationError,
    );
  });

  it("rejects an empty labels array", () => {
    expect(() => validateFileIssueRequest({ ...VALID, labels: [] }, TOOLCHAIN_PREFIX)).toThrow(ValidationError);
  });

  it("rejects a label outside the standard set -- mutation guard: allow any string and this fails", () => {
    expect(() =>
      validateFileIssueRequest({ ...VALID, labels: ["chore", "arbitrary-label"] }, TOOLCHAIN_PREFIX),
    ).toThrow(ValidationError);
  });

  // labels.json declares `exclusive: ["priority", "effort"]`, so one issue never carries two labels
  // from the same family. (Drop these two tests if your label source has no `exclusive` field.)
  it("rejects two labels from one exclusive group, naming the group -- mutation guard: drop the exclusive loop and this fails", () => {
    const req = { ...VALID, labels: ["chore", "priority: low", "priority: high"] };
    expect(() => validateFileIssueRequest(req, TOOLCHAIN_PREFIX)).toThrow(
      'labels ["priority: low","priority: high"] share the exclusive "priority" group; send one',
    );
  });

  it("accepts one label per exclusive group, and the same label sent twice -- mutation guard: drop the Set dedupe and this fails", () => {
    expect(validateFileIssueRequest({ ...VALID, labels: ["chore", "priority: low"] }, TOOLCHAIN_PREFIX).labels).toEqual([
      "chore",
      "priority: low",
    ]);
    const twice = { ...VALID, labels: ["priority: low", "priority: low"] };
    expect(validateFileIssueRequest(twice, TOOLCHAIN_PREFIX).labels).toEqual(["priority: low", "priority: low"]);
  });

  it("rejects a non-object payload (array, null, primitive)", () => {
    expect(() => validateFileIssueRequest(null, TOOLCHAIN_PREFIX)).toThrow(ValidationError);
    expect(() => validateFileIssueRequest([VALID], TOOLCHAIN_PREFIX)).toThrow(ValidationError);
    expect(() => validateFileIssueRequest("not an object", TOOLCHAIN_PREFIX)).toThrow(ValidationError);
  });
});

describe("assertRepoAllowed", () => {
  it("allows an exact match", () => {
    expect(() => assertRepoAllowed("<OWNER>/<REPO>", ["<OWNER>/<REPO>", "<OWNER>/<OTHER_REPO>"])).not.toThrow();
  });

  it("rejects a repo not in the allowlist -- mutation guard: remove the repo allowlist check and the Worker's 403 test fails", () => {
    expect(() => assertRepoAllowed("some-other/repo", ["<OWNER>/<REPO>"])).toThrow(RepoNotAllowedError);
  });

  it("never treats a prefix/substring match as allowed", () => {
    expect(() => assertRepoAllowed("<OWNER>/<REPO>-fork", ["<OWNER>/<REPO>"])).toThrow(RepoNotAllowedError);
  });

  it("rejects everything when the allowlist is empty -- fail closed, not open", () => {
    expect(() => assertRepoAllowed("<OWNER>/<REPO>", [])).toThrow(RepoNotAllowedError);
  });
});

describe("parseCsvEnv", () => {
  it("splits, trims, and drops empty entries", () => {
    expect(parseCsvEnv("<OWNER>/<REPO>, <OWNER>/<OTHER_REPO> ,")).toEqual([
      "<OWNER>/<REPO>",
      "<OWNER>/<OTHER_REPO>",
    ]);
  });

  it("parses undefined/empty as an empty array, not a crash", () => {
    expect(parseCsvEnv(undefined)).toEqual([]);
    expect(parseCsvEnv("")).toEqual([]);
  });
});

describe("isAllowedEmail", () => {
  it("matches case-insensitively and trims", () => {
    expect(isAllowedEmail("A@x.test", " a@X.test , b@x.test")).toBe(true);
  });
  it("refuses a missing or non-string claim, an unlisted email, and an empty list", () => {
    expect(isAllowedEmail(undefined, "a@x.test")).toBe(false);
    expect(isAllowedEmail(42, "a@x.test")).toBe(false);
    expect(isAllowedEmail("c@x.test", "a@x.test")).toBe(false);
    expect(isAllowedEmail("a@x.test", "")).toBe(false);
    expect(isAllowedEmail("a@x.test", undefined)).toBe(false);
  });
});
