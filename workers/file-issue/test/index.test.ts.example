import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import { env as rawEnv, createExecutionContext, waitOnExecutionContext } from "cloudflare:test";
import worker, { type Env } from "../src/index";
import { _resetJwksCacheForTests } from "../src/accessJwt";
import { certsUrl, makeAccessFixture } from "./support";

// `cloudflare:test`'s `env` merges wrangler.toml's real committed `[vars]` (ALLOWED_REPOS =
// "<OWNER>/<REPO>", ALLOWED_TITLE_PREFIXES = "<TITLE_PREFIX>") with vitest.config.ts's
// `miniflare.bindings` fixture values for the three SECRETS (GITHUB_TOKEN/ACCESS_TEAM_DOMAIN/
// ACCESS_AUD -- never committed config, see wrangler.toml's own comment). Only the compile-time
// type needs this cast to match this Worker's actual `Env` shape.
const env = rawEnv as unknown as Env;

const VALID_BODY = {
  repo: "<OWNER>/<REPO>",
  title: "<TITLE_PREFIX>upgrade Python on MILE to 3.14",
  body: "Installed: 3.12.10 on MILE",
  labels: ["chore", "priority: low"],
};

// The configured title prefix, read back from VALID_BODY.title (everything before "upgrade") so the
// tests below that need it don't carry a second literal you would have to edit.
// Fails loudly here, not as a confusing 400 later, if your VALID_BODY.title has no "upgrade".
// The 400 test below also assumes exactly one configured prefix (its message lists them all).
const UPGRADE_AT = VALID_BODY.title.indexOf("upgrade");
if (UPGRADE_AT < 0) throw new Error('VALID_BODY.title must contain "upgrade" after the title prefix');
const TITLE_PREFIX = VALID_BODY.title.slice(0, UPGRADE_AT);

// Every real caller is this site's own same-origin fetch(), which a browser marks with
// `Sec-Fetch-Site: same-origin` itself -- default it here so every OTHER test isn't forced to
// know about the cross-site check; the two tests for that check override/omit it explicitly.
function req(path: string, init: RequestInit = {}): Request {
  const headers = new Headers({ "Sec-Fetch-Site": "same-origin" });
  if (init.headers) {
    for (const [key, value] of new Headers(init.headers)) headers.set(key, value);
  }
  return new Request(`https://<HOSTNAME_1>${path}`, { ...init, headers });
}

describe("Worker fetch handler (#638)", () => {
  // See accessJwt.ts's _resetJwksCacheForTests docstring: without this, jose's remote-JWKS
  // cooldown makes every JWT-dependent test after the first fail with a spurious 401.
  beforeEach(() => {
    _resetJwksCacheForTests();
  });

  afterEach(() => {
    vi.unstubAllGlobals();
  });

  it("404s any path other than /api/file-issue", async () => {
    const ctx = createExecutionContext();
    const res = await worker.fetch(req("/api/something-else", { method: "POST" }), env, ctx);
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(404);
  });

  it("405s any method other than POST, naming the allowed method", async () => {
    const ctx = createExecutionContext();
    const res = await worker.fetch(req("/api/file-issue", { method: "GET" }), env, ctx);
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(405);
    expect(res.headers.get("Allow")).toBe("POST");
  });

  it("403s a cross-site request (Sec-Fetch-Site: cross-site) before ever checking the JWT", async () => {
    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Sec-Fetch-Site": "cross-site" },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(403);
  });

  it("403s a request with no Sec-Fetch-Site header at all -- fail closed, not open", async () => {
    const ctx = createExecutionContext();
    const bare = new Request("https://<HOSTNAME_1>/api/file-issue", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(VALID_BODY),
    });
    const res = await worker.fetch(bare, env, ctx);
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(403);
  });

  it("401s when the Cf-Access-Jwt-Assertion header is missing -- mutation guard: remove the JWT check and this fails", async () => {
    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(401);
  });

  it("403s a valid JWT with no email claim (a service token) -- mutation guard: remove the ALLOWED_EMAILS check and this fails", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    const githubCalls: string[] = [];
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        githubCalls.push(url);
        return new Response("should never be reached", { status: 500 });
      }),
    );
    const token = await signToken({ email: null });
    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(403);
    expect(githubCalls).toEqual([]);
  });

  it("403s a valid JWT whose email is not allowed, and accepts an allowed one in a different case", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    const githubCalls: string[] = [];
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        githubCalls.push(url);
        if (url.includes("/search/issues")) return new Response(JSON.stringify({ items: [] }), { status: 200 });
        return new Response(JSON.stringify({ number: 7, html_url: "https://github.com/<OWNER>/<REPO>/issues/7" }), { status: 201 });
      }),
    );
    const post = async (email: string) => {
      const token = await signToken({ email });
      const ctx = createExecutionContext();
      const res = await worker.fetch(
        req("/api/file-issue", {
          method: "POST",
          headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
          body: JSON.stringify(VALID_BODY),
        }),
        env,
        ctx,
      );
      await waitOnExecutionContext(ctx);
      return res;
    };

    const denied = await post("someone-else@example.test");
    expect(denied.status).toBe(403);
    expect(githubCalls).toEqual([]);

    const allowed = await post("Operator@Example.Test");
    expect(allowed.status).toBe(201);
  });

  it("400s when the title is outside the allowlist -- mutation guard: remove the title-prefix check and this fails", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        if (String(input) === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        return new Response("unexpected fetch in this test: " + String(input), { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify({ ...VALID_BODY, title: "Please upgrade Python on MILE" }),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(400);
  });

  // Assumes a `Label: ` style <TITLE_PREFIX> (ends in `: `); delete this test if yours does not.
  it("400s a title that omits the space after the configured prefix, through the real ALLOWED_TITLE_PREFIXES -- mutation guard: drop the re-added space and this fails", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        if (String(input) === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        return new Response("unexpected fetch in this test: " + String(input), { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify({ ...VALID_BODY, title: TITLE_PREFIX.trimEnd() + "upgrade Python on MILE to 3.14" }),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(400);
    expect(await res.json()).toEqual({ error: `"title" must start with one of: ${JSON.stringify(TITLE_PREFIX)}` });
  });

  it("403s when the repo is not in ALLOWED_REPOS and makes NO GitHub call -- mutation guard: remove the repo allowlist check and this fails", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    const githubCalls: string[] = [];
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/")) {
          githubCalls.push(url);
          return new Response("should never be reached", { status: 500 });
        }
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify({ ...VALID_BODY, repo: "some-other/repo" }),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(403);
    expect(githubCalls).toEqual([]);
  });

  it("returns 200 existing:true and makes NO create call when the issue already exists -- mutation guard: skip the dedupe search and this fails", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    const createCalls: unknown[] = [];
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/search/issues")) {
          return new Response(
            JSON.stringify({
              items: [
                { number: 701, html_url: "https://github.com/<OWNER>/<REPO>/issues/701", title: VALID_BODY.title },
              ],
            }),
            { status: 200 },
          );
        }
        if (url === "https://api.github.com/repos/<OWNER>/<REPO>/issues" && init?.method === "POST") {
          createCalls.push(init);
          return new Response(JSON.stringify({ number: 999, html_url: "should-not-be-used" }), { status: 201 });
        }
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(200);
    expect(await res.json()).toEqual({
      number: 701,
      url: "https://github.com/<OWNER>/<REPO>/issues/701",
      existing: true,
    });
    expect(createCalls.length).toBe(0);
  });

  it("escapes a backslash as well as a quote in the dedupe search phrase -- mutation guard: put the quote-only escape back and this fails", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    const searchUrls: string[] = [];
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/search/issues")) {
          searchUrls.push(url);
          return new Response(JSON.stringify({ items: [] }), { status: 200 });
        }
        if (url === `https://api.github.com/repos/${VALID_BODY.repo}/issues` && init?.method === "POST") {
          return new Response(
            JSON.stringify({ number: 707, html_url: `https://github.com/${VALID_BODY.repo}/issues/707` }),
            { status: 201 },
          );
        }
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    // The title carries a backslash followed by a quote: Foo\"Bar.
    const title = TITLE_PREFIX + 'upgrade Foo\\"Bar on MILE to 1.0';
    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify({ ...VALID_BODY, title }),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(201);
    // In a quoted search phrase `\` is the escape character, so each of the two characters is
    // escaped: the backslash becomes `\\` and the quote becomes `\"`.
    expect(new URL(searchUrls[0] ?? "").searchParams.get("q")).toBe(
      `repo:${VALID_BODY.repo} is:issue is:open in:title "${TITLE_PREFIX}upgrade Foo\\\\\\"Bar on MILE to 1.0"`,
    );
  });

  it("502s with the generic body, and logs the shape problem, when the dedupe search returns a 200 without an items array -- mutation guard: drop the check in findExistingIssue and this fails", async () => {
    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/search/issues")) return new Response("{}", { status: 200 });
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(502);
    expect(await res.text()).toBe(JSON.stringify({ error: "upstream" }));
    // Without the check the failure is still a GitHubError (the outer catch wraps a TypeError),
    // but its message is a JS engine's "Cannot read properties of undefined" -- not this one.
    expect(warnSpy).toHaveBeenCalledWith("github: GitHub search returned an unexpected shape");
    warnSpy.mockRestore();
  });

  it("502s, not a 200 existing:true with no url, when a matching search entry lacks fields -- mutation guard: weaken findExistingIssue's check to Array.isArray and this fails", async () => {
    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/search/issues")) {
          // The title matches; the entry has no html_url.
          return new Response(JSON.stringify({ items: [{ number: 708, title: VALID_BODY.title }] }), { status: 200 });
        }
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(502);
    expect(await res.text()).toBe(JSON.stringify({ error: "upstream" }));
    expect(warnSpy).toHaveBeenCalledWith("github: GitHub search returned an unexpected shape");
    warnSpy.mockRestore();
  });

  it("creates the issue and returns 201 when no existing match is found", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/search/issues")) {
          return new Response(JSON.stringify({ items: [] }), { status: 200 });
        }
        if (url === "https://api.github.com/repos/<OWNER>/<REPO>/issues" && init?.method === "POST") {
          // `repo` routes the URL only -- it must never leak into the GitHub payload itself.
          expect(JSON.parse(init.body as string)).toEqual({
            title: VALID_BODY.title,
            body: VALID_BODY.body,
            labels: VALID_BODY.labels,
          });
          return new Response(
            JSON.stringify({ number: 702, html_url: "https://github.com/<OWNER>/<REPO>/issues/702" }),
            { status: 201 },
          );
        }
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(201);
    expect(await res.json()).toEqual({ number: 702, url: "https://github.com/<OWNER>/<REPO>/issues/702" });
  });

  it("502s with a generic body when GitHub itself fails (e.g. rate-limited) -- the reason goes to console.warn, never the response -- mutation guard: put err.message back and this fails", async () => {
    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        if (url.startsWith("https://api.github.com/search/issues")) {
          return new Response(JSON.stringify({ message: "API rate limit exceeded" }), { status: 403 });
        }
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(502);
    const text = await res.text();
    expect(text).toBe(JSON.stringify({ error: "upstream" }));
    expect(text).not.toContain("rate limit");
    expect(warnSpy).toHaveBeenCalledWith(expect.stringContaining("rate limit"));
    warnSpy.mockRestore();
  });

  // --- generic error bodies: the 401/502 sites echo nothing from the underlying error --
  it("a missing JWT header and an invalid JWT both 401 with the identical generic body -- mutation guard: put err.message back in either 401 site and this fails", async () => {
    const missingHeaderCtx = createExecutionContext();
    const missingHeaderRes = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      missingHeaderCtx,
    );
    await waitOnExecutionContext(missingHeaderCtx);
    expect(missingHeaderRes.status).toBe(401);
    const missingHeaderText = await missingHeaderRes.text();

    const { jwksResponseBody } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        const url = String(input);
        if (url === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        return new Response("unexpected fetch in this test: " + url, { status: 500 });
      }),
    );
    const invalidJwtCtx = createExecutionContext();
    const invalidJwtRes = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": "not-a-real-jwt" },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      invalidJwtCtx,
    );
    await waitOnExecutionContext(invalidJwtCtx);
    expect(invalidJwtRes.status).toBe(401);
    const invalidJwtText = await invalidJwtRes.text();

    expect(missingHeaderText).toBe(JSON.stringify({ error: "unauthorized" }));
    expect(invalidJwtText).toBe(JSON.stringify({ error: "unauthorized" }));
    expect(missingHeaderText).toBe(invalidJwtText);
  });

  it("logs the JWT-validation detail to console.warn without ever putting it in the response", async () => {
    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(VALID_BODY),
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(401);
    expect(await res.text()).toBe(JSON.stringify({ error: "unauthorized" }));
    expect(warnSpy).toHaveBeenCalledWith(expect.stringContaining("no Cf-Access-Jwt-Assertion header"));
    warnSpy.mockRestore();
  });

  it("400s on a malformed JSON body", async () => {
    const { jwksResponseBody, signToken } = await makeAccessFixture();
    vi.stubGlobal(
      "fetch",
      vi.fn(async (input: RequestInfo | URL) => {
        if (String(input) === certsUrl()) return new Response(jwksResponseBody, { status: 200 });
        return new Response("unexpected", { status: 500 });
      }),
    );
    const token = await signToken();

    const ctx = createExecutionContext();
    const res = await worker.fetch(
      req("/api/file-issue", {
        method: "POST",
        headers: { "content-type": "application/json", "Cf-Access-Jwt-Assertion": token },
        body: "{not valid json",
      }),
      env,
      ctx,
    );
    await waitOnExecutionContext(ctx);
    expect(res.status).toBe(400);
  });
});
